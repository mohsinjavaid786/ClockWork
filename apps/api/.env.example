# Supabase — use the service role key (server-side only, never expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 0 for direct access. Set to the verified number of trusted reverse proxies
# in front of the API so rate limits use the client IP. Never use "true".
TRUST_PROXY_HOPS=0

# Server
PORT=3001
ADMIN_URL=http://localhost:3000

# Email (Resend) — required for invite + password-reset emails.
# Without a verified domain in Resend, use onboarding@resend.dev (test mode only
# delivers to your own Resend account email).
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=Clockwork <onboarding@resend.dev>

# Company name shown in emails (falls back to "your team")
COMPANY_NAME=Clockwork

# Installer download links used in invite emails. Optional — if unset they are
# derived from SUPABASE_URL + the public "installers" bucket
# (latest/Clockwork.dmg, latest/Clockwork.exe). Set only to override.
# DOWNLOAD_URL_MACOS=
# DOWNLOAD_URL_WINDOWS=
